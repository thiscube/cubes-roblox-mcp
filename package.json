{
  "name": "cubes-roblox-mcp",
  "version": "0.2.0",
  "type": "module",
  "description": "An MCP server for Roblox Studio: progressive tool disclosure, a derived write gate, and the engine API reference built in.",
  "bin": {
    "cubes-roblox-mcp": "dist/index.js",
    "cubes-roblox-mcp-inspector": "dist/inspector.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "npm run build && node test/run.mjs",
    "test:unit": "node test/run.mjs",
    "test:e2e": "node test/harness.mjs",
    "test:repl": "node test/harness.mjs --interactive",
    "bench": "node test/bench/tool-churn.mjs && node test/bench/poll-latency.mjs",
    "install-plugin": "node dist/index.js --install-plugin",
    "prepublishOnly": "npm run build && node test/run.mjs",
    "prepare": "npm run build",
    "ci": "npx tsc --noEmit && npm run build && CUBES_MCP_OFFLINE=1 node test/run.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "minisearch": "^7.1.2",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/ws": "^8.18.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thiscube/cubes-roblox-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/thiscube/cubes-roblox-mcp/issues"
  },
  "homepage": "https://github.com/thiscube/cubes-roblox-mcp#readme",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "roblox",
    "roblox-studio",
    "luau",
    "claude"
  ],
  "files": [
    "dist",
    "plugin",
    "docs",
    "README.md",
    "SECURITY.md",
    "CLAUDE.md",
    "PLAN.md"
  ],
  "publishConfig": {
    "access": "public"
  }
}
